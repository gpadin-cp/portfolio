---
import "../styles/global.css";
import fontUrl from "@fontsource-variable/recursive/files/recursive-latin-mono-normal.woff2?url";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "@portfolio/content";

interface Props { title?: string; description?: string; type?: "website" | "article"; noindex?: boolean }
const { title, description = site.positioning, type = "website", noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, full-stack engineer`;
// build.format "file" puts the .html filename in the pathname; the public URL has no extension.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "") || "/";
const canonical = new URL(path, Astro.site);
const isHome = path === "/";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.href,
  jobTitle: "Full-stack engineer",
  email: `mailto:${site.email}`,
  sameAs: site.links.map((l) => l.href),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f2f3f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <!-- Apply the saved theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="page colophon soft">
      <p>Built with Astro and served by Cloudflare. <a href="https://github.com/gpadin-cp/portfolio">Read the source on GitHub</a>.</p>
    </footer>
  </body>
</html>

<style>
  .colophon {
    font-size: var(--step--1);
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--rule);
  }
</style>
