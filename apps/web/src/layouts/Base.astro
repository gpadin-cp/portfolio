---
import "../styles/global.css";
import fontUrl from "@fontsource-variable/recursive/files/recursive-latin-mono-normal.woff2?url";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site } from "@portfolio/content";

interface Props { title?: string; description?: string; type?: "website" | "article" }
const { title, description = site.positioning, type = "website" } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, full-stack engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const nav = [
  { id: "about", label: "About" },
  { id: "work", label: "Work" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.href,
  jobTitle: "Full-stack engineer",
  email: `mailto:${site.email}`,
  sameAs: site.links.map((l) => l.href),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f2f3f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <!-- Apply the saved theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="page masthead">
      <a class="name" href="/">{site.name}</a>
      <nav aria-label="Sections">
        {nav.map((n) => <a href={`/#${n.id}`}>{n.label}</a>)}
      </nav>
      <ThemeToggle />
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="page colophon soft">
      <p>Built with Astro and served by Cloudflare. <a href="https://github.com/gpadin-cp/portfolio">Read the source on GitHub</a>.</p>
    </footer>
  </body>
</html>

<style>
  .masthead {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }
  .name { color: var(--ink); text-decoration: none; font-weight: 700; margin-right: auto; }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  nav a { color: var(--ink-soft); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  .colophon {
    font-size: var(--step--1);
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--rule);
  }
</style>
