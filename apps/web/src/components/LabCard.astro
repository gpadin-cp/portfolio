---
import type { LabEntry } from "@portfolio/content";
interface Props { entry: LabEntry }
const { entry } = Astro.props;
---
<li class="card">
  <p class="muted"><time datetime={entry.date}>{entry.date}</time>{entry.draft && " · draft"}</p>
  <h3>{entry.title}</h3>
  <p>{entry.summary}</p>
  <ul class="tags">
    {entry.demo && <li><a href={entry.demo}>Live demo</a></li>}
    {entry.source && <li><a href={entry.source}>Source</a></li>}
    {entry.writeUp && <li><a href={entry.writeUp}>Write-up</a></li>}
  </ul>
</li>
