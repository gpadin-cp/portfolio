---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "@portfolio/content";

const nav = [
  { id: "about", label: "About" },
  { id: "work", label: "Work" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];
const path = Astro.url.pathname;
const section = path.startsWith("/work") ? "work" : path.startsWith("/writing") ? "writing" : null;
---
<header class="site-header" data-site-header>
  <div class="page bar">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <span class="name">{site.name}</span>
      <span class="role">{site.role}</span>
    </a>
    <nav aria-label="Sections">
      {nav.map((n) => (
        <a href={`/#${n.id}`} data-nav={n.id} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .site-header[data-stuck] { border-bottom-color: var(--rule); }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "mark theme" "nav nav";
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-2);
  }
  .wordmark { grid-area: mark; display: grid; text-decoration: none; line-height: 1.2; min-width: 0; }
  .name { color: var(--ink); font-weight: 750; font-size: var(--step-0); letter-spacing: -0.01em; }
  .role { color: var(--ink-soft); font-size: var(--step--1); }
  .site-header :global(.theme) { grid-area: theme; }

  nav { grid-area: nav; display: flex; gap: var(--space-3); overflow-x: auto; }
  nav a {
    color: var(--ink-soft); text-decoration: none; white-space: nowrap;
    padding-block: 0.2rem; border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current] { color: var(--ink); border-bottom-color: var(--accent); }

  @media (min-width: 44rem) {
    .bar { grid-template-columns: 1fr auto auto; grid-template-areas: "mark nav theme"; gap: var(--space-4); padding-block: var(--space-3); }
    nav { gap: var(--space-4); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const onScroll = () => header.toggleAttribute("data-stuck", window.scrollY > 4);
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
  }

  // On the home page, underline the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((a) => [a.dataset.nav!, a]),
  );
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a, id) => (id === e.target.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
