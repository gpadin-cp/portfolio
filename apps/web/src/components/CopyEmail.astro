---
interface Props { email: string }
const { email } = Astro.props;
---
<div class="email">
  <a href={`mailto:${email}`}>{email}</a>
  <button type="button" data-copy={email}>Copy</button>
</div>

<style>
  .email { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  a { font-size: var(--step-2); font-weight: 600; overflow-wrap: anywhere; }
  button {
    font: inherit; font-size: var(--step--1); color: var(--ink-soft);
    background: none; border: 1px solid var(--rule); border-radius: 999px;
    padding: 0.15rem 0.75rem; cursor: pointer;
  }
  button:hover { color: var(--ink); border-color: var(--ink-soft); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) =>
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied";
      } catch {
        const link = btn.previousElementSibling;
        if (link) getSelection()?.selectAllChildren(link);
        btn.textContent = "Selected";
      }
      setTimeout(() => (btn.textContent = "Copy"), 2000);
    }),
  );
</script>
