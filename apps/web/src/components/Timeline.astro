---
import { experience } from "@portfolio/content";
---
<ol class="timeline">
  {experience.map((r) => (
    <li>
      <p class="muted">{r.start} – {r.end ?? "Present"}</p>
      <h3>{r.title} · {r.companyUrl ? <a href={r.companyUrl}>{r.company}</a> : r.company}</h3>
      {r.summary.map((s) => <p>{s}</p>)}
      {r.tags.length > 0 && <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>}
      {r.related && <a href={r.related.href}>{r.related.label} →</a>}
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; padding: 0; display: grid; gap: var(--space-5); max-width: var(--measure); }
  h3 { margin: 0 0 var(--space-2); font-size: 1.1rem; }
  p { margin: 0 0 var(--space-2); }
</style>
