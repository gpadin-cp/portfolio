---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <div class="missing">
    <h1>This page doesn't exist.</h1>
    <p>It may have moved. <a href="/">Go to the home page</a>.</p>
  </div>
</Base>

<style>
  .missing { display: grid; gap: var(--space-3); padding-block: var(--space-6); }
  h1 { font-size: var(--step-2); }
</style>
