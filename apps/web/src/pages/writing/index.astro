---
import Base from "../../layouts/Base.astro";
import WritingList from "../../components/WritingList.astro";
import { posts } from "@portfolio/content";
import { visible } from "../../lib/visible";
const list = visible(posts).sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Writing" description="Posts on system design, delivery decisions, and running an AI agent fleet.">
  <h1 class="title">Writing</h1>
  <WritingList posts={list} />
</Base>

<style>
  .title { font-size: var(--step-2); font-weight: 700; padding-block: var(--space-5) var(--space-4); }
</style>
