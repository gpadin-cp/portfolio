---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import { caseStudies, type CaseStudy } from "@portfolio/content";
import { visible } from "../../lib/visible";

export function getStaticPaths() {
  return visible(caseStudies).map((study) => ({ params: { slug: study.slug }, props: { study } }));
}
const { study } = Astro.props as { study: CaseStudy };
---
<Base title={study.title} description={study.outcome}>
  <article class="prose">
    <p class="muted">{study.company} · {study.role}</p>
    <h1>{study.title}</h1>
    {study.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
  </article>
  <AdSlot id="case-study-end" />
</Base>
