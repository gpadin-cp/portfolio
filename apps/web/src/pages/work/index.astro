---
import Base from "../../layouts/Base.astro";
import CaseCard from "../../components/CaseCard.astro";
import { caseStudies } from "@portfolio/content";
import { visible } from "../../lib/visible";
const work = visible(caseStudies).sort((a, b) => a.order - b.order);
---
<Base title="Work">
  <h1>Work</h1>
  <ul class="cards">{work.map((s) => <CaseCard study={s} />)}</ul>
</Base>
