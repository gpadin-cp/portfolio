---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import WorkList from "../components/WorkList.astro";
import WritingList from "../components/WritingList.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { site, caseStudies, experience, posts } from "@portfolio/content";
import { visible } from "../lib/visible";

const work = visible(caseStudies).sort((a, b) => a.order - b.order);
const latest = visible(posts).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
---
<Base>
  <div class="hero">
    <h1>{site.headline}</h1>
    <p class="soft">{site.positioning}</p>
  </div>

  <Section id="about" title="About">
    <div class="about">
      <div class="prose">{site.about.map((p) => <p>{p}</p>)}</div>
      <ul class="roles">
        {experience.map((r) => (
          <li>
            <span class="company">{r.company}</span>
            {r.title !== "TBD" && <span class="soft">{r.title}</span>}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section id="work" title="Work">
    <WorkList studies={work} />
  </Section>

  <Section id="writing" title="Writing">
    <WritingList posts={latest} />
    {posts.length > latest.length && <p class="more"><a href="/writing">All posts</a></p>}
  </Section>

  <Section id="contact" title="Contact">
    <div class="contact">
      <p class="prose">I'm looking for staff or senior full-stack roles, remote or hybrid in New York. Email is the fastest way to reach me.</p>
      <CopyEmail email={site.email} />
      <ul class="elsewhere">
        {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.resumePdf}>Resume (PDF)</a></li>
      </ul>
    </div>
  </Section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
  }
  .hero h1 {
    font-size: var(--step-hero);
    font-weight: 780;
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 17ch;
  }
  .hero p { font-size: var(--step-1); max-width: 40ch; line-height: 1.45; }

  .prose { display: grid; gap: var(--space-2); max-width: var(--measure); }

  .about { display: grid; gap: var(--space-4); }
  .roles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); align-content: start; }
  .roles li { display: grid; line-height: 1.35; }
  .company { font-weight: 600; }
  @media (min-width: 64rem) {
    .about { grid-template-columns: 1fr 16rem; }
  }

  .more { margin-top: var(--space-3); }

  .contact { display: grid; gap: var(--space-3); }
  .elsewhere { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
</style>
