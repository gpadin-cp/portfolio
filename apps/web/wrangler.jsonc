{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gregpadin-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "gregpadin.com", "custom_domain": true }
  ]
}
